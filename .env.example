# =============================================================================
# RED OR BLACK — backend. Copy to .env. .env is git-ignored; NEVER commit a key.
# =============================================================================

PORT=8080
ROUND_MS=300000            # 5 minutes, aligned to the wall clock

# --- the coin ----------------------------------------------------------------
# Empty = DEMO (simulated pot). Can also be set live: POST /set-ca
TOKEN=

# --- arming ------------------------------------------------------------------
# Nothing is sent until DRY_RUN=false AND TREASURY_SECRET is the coin's creator.
DRY_RUN=true
# The wallet that LAUNCHED the coin on pump.fun (creator rewards go there).
# Base58 64-byte secret (87–88 chars) or a JSON byte array. Railway only.
TREASURY_SECRET=

# ⚠ A real RPC. The public endpoint rate-limits the pot poll into the ground.
RPC_URL=https://api.mainnet-beta.solana.com
EXPLORER_URL=https://solscan.io

# --- the pot -----------------------------------------------------------------
LEAVE_SOL=0.01             # always stays in the wallet for fees
MIN_BUY_SOL=0.01           # a win below this rolls over instead of buying
MAX_BUY_SOL=               # optional ceiling per buyback
CLAIM_MIN_SOL=0.0005       # vaults below this are not worth a claim tx
SLIPPAGE_BPS=1500
PRIORITY_FEE_MICROLAMPORTS=200000
BURN_MODE=bought           # bought = burn exactly what the buyback bought · all = the whole wallet bag
POT_POLL_MS=15000

# --- votes -------------------------------------------------------------------
MAX_VOTERS_PER_IP=4

# --- admin -------------------------------------------------------------------
# Enables POST /set-ca and POST /set-pot (x-admin-password header). Empty = off.
ADMIN_PASSWORD=

# --- receipts ----------------------------------------------------------------
MONGO_URL=
MONGO_DB=redorblack

# --- demo --------------------------------------------------------------------
DEMO_POT_SOL=1.2

# --- branding (sent to the page) ---------------------------------------------
SITE_NAME=RED OR BLACK
COIN_TICKER=ROB
TWITTER_URL=
SITE_URL=
